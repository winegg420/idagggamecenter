# Cloudflare Pages başlıkları. (Vercel bu dosyayı yok sayar.)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), payment=()

# Service worker asla uzun süre önbelleğe alınmamalı:
# eski sw.js takılı kalırsa kullanıcı güncellemeyi hiç görmez.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache

# Vite çıktısı içerik özetli (hash) dosya adları üretir — uzun önbellek güvenli.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
